<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_principal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".telas.DetalhesActivity"
    tools:theme="@style/Theme.MoveUP">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra_titulo"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/titulo_detalhes"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationContentDescription="@string/voltar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/barra_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">
            <ImageView
                android:id="@+id/img_exercicio"
                android:layout_width="0dp"
                android:layout_height="200dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/img_mascote"
                android:background="@drawable/fundo_imagem"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/foto_exercicio"/>
            <TextView
                android:id="@+id/tv_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/img_exercicio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/nome_exercicio"
                android:textSize="24sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"/>
            <TextView
                android:id="@+id/tv_resumo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_nome"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/series_exercicio"
                android:textSize="16sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"/>
            <TextView
                android:id="@+id/tv_descricao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_resumo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/descricao_exercicio"
                android:textSize="16sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"/>
            <TextView
                android:id="@+id/tv_aviso_imagem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_descricao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/imagem_ilustrativa"
                android:textSize="12sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"/>
            <Button
                android:id="@+id/btn_editar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_aviso_imagem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/editar_exercicio"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"/>
            <Button
                android:id="@+id/btn_compartilhar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/btn_editar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/compartilhar_exercicio"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"/>
            <Button
                android:id="@+id/btn_site"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/btn_compartilhar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/abrir_site"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"/>
            <Button
                android:id="@+id/btn_excluir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/btn_site"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/excluir_exercicio"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
