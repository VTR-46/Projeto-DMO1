<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_principal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".telas.CadastroActivity"
    tools:theme="@style/Theme.MoveUP">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra_titulo"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/novo_exercicio"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationContentDescription="@string/voltar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/barra_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">
            <ImageView
                android:id="@+id/img_exercicio"
                android:layout_width="0dp"
                android:layout_height="150dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/img_mascote"
                android:background="@drawable/fundo_imagem"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/foto_exercicio"/>
            <Button
                android:id="@+id/btn_imagem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/img_exercicio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/escolher_imagem"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tv_rotulo_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/btn_imagem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/nome_exercicio"
                android:textSize="14sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"
                android:labelFor="@id/et_nome"/>
            <EditText
                android:saveEnabled="false"
                android:id="@+id/et_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_rotulo_nome"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                android:inputType="textCapSentences"
                android:maxLength="80"
                android:minHeight="48dp"
                android:autofillHints=""
                android:maxLines="1"/>
            <TextView
                android:id="@+id/tv_rotulo_descricao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/et_nome"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/descricao_exercicio"
                android:textSize="14sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"
                android:labelFor="@id/et_descricao"/>
            <EditText
                android:saveEnabled="false"
                android:id="@+id/et_descricao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_rotulo_descricao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:minHeight="48dp"
                android:autofillHints=""
                android:minLines="3"
                android:gravity="top"/>
            <TextView
                android:id="@+id/tv_rotulo_series"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/et_descricao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/series_exercicio"
                android:textSize="14sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"
                android:labelFor="@id/et_series"/>
            <EditText
                android:saveEnabled="false"
                android:id="@+id/et_series"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_rotulo_series"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                android:inputType="number"
                android:maxLength="2"
                android:minHeight="48dp"
                android:autofillHints=""
                android:maxLines="1"/>
            <TextView
                android:id="@+id/tv_rotulo_repeticoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/et_series"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/repeticoes_exercicio"
                android:textSize="14sp"
                android:textColor="@color/texto"
                android:layout_marginTop="12dp"
                android:labelFor="@id/et_repeticoes"/>
            <EditText
                android:saveEnabled="false"
                android:id="@+id/et_repeticoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_rotulo_repeticoes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                android:inputType="number"
                android:maxLength="3"
                android:minHeight="48dp"
                android:autofillHints=""
                android:maxLines="1"/>
            <Button
                android:id="@+id/btn_salvar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/et_repeticoes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/salvar"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
