    <string name="descricao_supino">Deite no banco com os pés apoiados. Desça a barra com controle em direção ao peito e empurre para cima. Peça auxílio ao instrutor para preparar o exercício.</string>
    <string name="nome_remada">Remada baixa</string>
    <string name="descricao_remada">Sente com os pés apoiados e o tronco estável. Puxe o pegador em direção à cintura e retorne com controle.</string>
